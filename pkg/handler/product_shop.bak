func (h *Handler) ListShopProducts(c *gin.Context) {
 pagination := &models.Pagination{
     Page:  h.StrToInt(c.Query("page"), 1),
     Limit: h.StrToInt(c.Query("limit"), 20),
     Sort:  c.DefaultQuery("sort", "id desc"),
 }

 offset := (pagination.Page - 1) * pagination.Limit

 var rows []productScanRow

 err := h.db.Raw(`
  SELECT
     p.id,
     p.name,
     p.description,
     (p.state = 400) AS promoted,
     COALESCE(img.image_path, '') AS image_path,
     COALESCE(sku_agg.min_price, 0) AS min_price,
     COALESCE(sku_agg.max_price, 0) AS max_price,
     COALESCE(like_agg.total_score, 0) AS likes_count,
     COALESCE(review_agg.cnt, 0) AS reviews_count,
     COALESCE(sku_agg.sku_count, 0) AS sku_count,
     COALESCE(sku_agg.skus_json, '[]'::json) AS skus

  FROM products p

  LEFT JOIN LATERAL (
    SELECT image_path
    FROM dbo.images
    WHERE product_id = p.id and type = 200
    LIMIT 1
  ) img ON true

  LEFT JOIN LATERAL (
   SELECT
       COUNT(l.id) AS cnt,
       COALESCE(SUM(l.score), 0) AS total_score
   FROM likes l
   WHERE l.product_id = p.id
  ) like_agg ON true

  LEFT JOIN LATERAL (
   SELECT COUNT(r.id) AS cnt
   FROM reviews r
   WHERE r.product_id = p.id
  ) review_agg ON true

  JOIN LATERAL (
   SELECT
       MIN(s.price) AS min_price,
       MAX(s.price) AS max_price,
       COUNT(s.id) AS sku_count,
       json_agg(
           jsonb_build_object(
               'id', s.id,
               'code', s.code,
               'price', s.price,
               'stock', s.stock,
               'options', COALESCE(
                   (SELECT jsonb_agg(
                       jsonb_build_object(
                           'name', v.name,
                           'value', o.value
                       )
                   )
                   FROM sku_options so
                   JOIN options o ON o.id = so.option_id
                   JOIN variants v ON v.id = o.variant_id
                   WHERE so.sk_uid = s.id
                   ), '[]'::jsonb)
           )
       ) AS skus_json
   FROM skus s
   WHERE s.product_id = p.id
   HAVING COUNT(s.id) > 0
  ) sku_agg ON true

  WHERE p.state >= $1
  ORDER BY p.id DESC
  LIMIT $2 OFFSET $3
 `, models.ProductStateActive, pagination.Limit, offset).Scan(&rows).Error

 if err != nil {
     c.JSON(http.StatusInternalServerError, gin.H{
         "status": "error",
         "message": err.Error(),
     })
     return
 }

 // Convert scan rows -> response items
 products := make([]ProductShopListItem, len(rows))
 for i, row := range rows {
    products[i] = ProductShopListItem{
      ID          : row.ID,
      Name        : row.Name,
      Description : row.Description,
      Promoted    : row.Promoted,
      ImagePath:    row.ImagePath,
      MinPrice:     row.MinPrice,
      MaxPrice:     row.MaxPrice,
      LikesCount:   row.LikesCount,
      ReviewsCount: row.ReviewsCount,
      SKUCount:     row.SKUCount,
    }

    //Unmarshal the raw JSON into the typed slice
    if row.SKUsJSON != "" && row.SKUsJSON != "[]" {
      if err := json.Unmarshal([]byte(row.SKUsJSON), &products[i].SKUs); err != nil {
        c.JSON(http.StatusInternalServerError, gin.H{
          "status": "error",
          "message": "failed to parse SKUs: " + err.Error(),
        })
        return
      }
    } else {
      products[i].SKUs = []SKUReturnItem{}
    }

 }

 var totalCount int64

 err = h.db.Raw(`
   SELECT COUNT(*)
   FROM products p
   JOIN LATERAL (
     SELECT 1 FROM skus s WHERE s.product_id = p.id LIMIT 1
   ) sku_exists ON true
   WHERE p.state >= ?
   `, models.ProductStateActive).Scan(&totalCount).Error

 pagination.TotalRows = totalCount
 pagination.TotalPages = int(math.Ceil(float64(totalCount) / float64(pagination.Limit)))
//   (totalCount + pagination.Limit - 1) / pagination.Limit
 pagination.Rows = products
 pagination.Context = "default"
 c.JSON(http.StatusOK, pagination)
}
